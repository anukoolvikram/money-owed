    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.11.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
