# Copy to .env.local for local development. Placeholders only - never commit real values.
# All of these are SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.

# Runtime connection: least-privilege role, Neon *pooled* endpoint (host contains "-pooler"), TLS required.
DATABASE_URL="postgresql://ledger_app:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=verify-full"

# Migration/provisioning connection: schema-owning role, Neon *direct* (non-pooled) endpoint.
# Used only by terminal commands (migrate, provision, recover). Do NOT add to Vercel.
MIGRATION_DATABASE_URL="postgresql://ledger_admin:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=verify-full"

# Generate locally with:  openssl rand -base64 32   (paste into the file yourself, do not share it)
BETTER_AUTH_SECRET="<at-least-32-random-characters>"

# Exact public origin of the app, no trailing slash.
BETTER_AUTH_URL="http://localhost:3000"

# Optional: comma-separated extra exact origins (no wildcards), e.g. a custom domain.
# TRUSTED_ORIGINS="https://ledger.example.com"

# Header used for the client IP in sign-in throttling. On Vercel use x-vercel-forwarded-for.
# Leave empty locally (all local requests share one IP bucket).
AUTH_CLIENT_IP_HEADER=""
